<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Momentum</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>
  
  <Target Name="BuildClient" BeforeTargets="Build" Condition="'$(EnableBuildClient)' != 'false'">
    <!-- npm ci обязателен, когда хэш package-lock.json не совпадает с установленным деревом
         (штамп .momentum-lock-stamp пишется после успешной установки). Даты ненадёжны:
         восстановленный из кэша node_modules новее свежего lockfile. -->
    <Exec Command="node -e &quot;const fs=require('fs'),c=require('crypto');const h=c.createHash('sha256').update(fs.readFileSync('package-lock.json')).digest('hex');const s='node_modules/.momentum-lock-stamp';if(fs.existsSync(s)&amp;&amp;fs.readFileSync(s,'utf8')===h){process.exit(0)}console.log('lockfile изменился — npm ci…');fs.rmSync('node_modules',{recursive:true,force:true});require('child_process').execSync('npm ci',{stdio:'inherit'});fs.writeFileSync(s,h)&quot;"
          WorkingDirectory="../client" />
    <Exec Command="npm run export:web" WorkingDirectory="../client" />
    <ItemGroup>
      <_ClientDist Include="../client/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ClientDist)"
          DestinationFiles="@(_ClientDist->'$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  
  <Target Name="CleanPublishJunk" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)tests;$(PublishDir)publish;$(PublishDir)data" />
  </Target>

</Project>
